  "verdict_review": {
    "added": "2026-08-12",
    "status": "the recorded verdict above is WRONG. It is left exactly as run.",
    "why": "The criterion required only that the matched-width lift be positive at more than 2 pooled SD. It never required the TRAINED arm to reach a positive R^2 on the residual. It fired on concat_strikes, whose lift runs from -0.0173 to -0.0023: both endpoints are negative R^2, so neither arm predicts the residual better than its own mean. Being less bad at a task neither model can do is not evidence of carrying information.",
    "corrected_criterion": "the trained arm must ALSO reach a residual R^2 significantly above zero across seeds, not merely above the untrained arm",
    "best_trained_residual": {
      "readout": "last_patch",
      "dim": 128,
      "ridge_mean": 0.00378413386093035,
      "ridge_std": 0.004501882202024563,
      "seeds": 4,
      "se": 0.0022509411010122817,
      "t_vs_zero": 1.681134108408509,
      "df": 3,
      "t_crit_p05_two_tailed": 3.182,
      "significant_above_zero": false
    },
    "corrected_verdict": "RECONSTRUCTION. No arm reaches a residual R^2 distinguishable from zero; the best is last_patch at +0.0038 +- 0.0045, t = 1.68 against t_crit 3.182. The encoder carries nothing about vol_forecast_error that the 96-dim raw cross-section does not already carry, so the +7.73 pooled SD training lift measured in E7 is the encoder representing the INPUT better rather than learning anything about the future.",
    "precedent": "third mis-specified gate in this programme, after E1's 'at any checkpoint' and E2's 'the mechanism helps'. Recorded beside the original rather than replacing it, per docs/RESEARCH_PLAN.md rule 1."
  }
